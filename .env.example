# CQA — copy to .env and fill in. Never commit .env.
CQA_SERVICE=all
# CQA_DATABASE_URL=  (default: sqlite file in ./data, absolute path resolved by the app)
# CQA_DATABASE_URL=postgresql+psycopg://cqa:cqa@localhost:5432/cqa
# CQA_REDIS_URL=redis://localhost:6379/0

# Organisers' Power Automate endpoint (signed URL from the task; group_id is added by the app)
CQA_ORG_API_URL=

# Providers: fallback order; a provider without a key is skipped. "rules" = offline fallback.
CQA_PROVIDER_CHAIN=openai,anthropic,gemini,deepseek,ollama,rules
CQA_OPENAI_API_KEY=
CQA_OPENAI_MODEL=gpt-5.5
CQA_ANTHROPIC_API_KEY=
CQA_GEMINI_API_KEY=
CQA_DEEPSEEK_API_KEY=
CQA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CQA_OLLAMA_MODEL=qwen3.5:9b
CQA_SECOND_OPINION_PROVIDER=
CQA_LLM_PARALLEL=4
CQA_LLM_BUDGET_USD=5
CQA_MASK_PII=true
CQA_TEAM_NAME=Bratva Aitu
